NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=rentnest_db
DB_CONNECTION_LIMIT=20

# Authentication Secrets
JWT_ACCESS_SECRET=rentnest_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=rentnest_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10
