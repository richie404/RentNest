<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="BrowseController"
            stylesheets="@browse.css"
            styleClass="bg-default">

    <!-- 🔹 Shared TopBar -->
    <top>
        <fx:include source="TopBar.fxml" fx:id="topBar"/>
    </top>

    <!-- 🔹 Filters (Left Sidebar) -->
    <left>
        <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
            <content>
                <VBox spacing="20" styleClass="sidebar">
                    <fx:define>
                        <ToggleGroup fx:id="priceGroup"/>
                        <ToggleGroup fx:id="bedGroup"/>
                    </fx:define>

                    <Label text="Filters" styleClass="sidebar-title"/>

                    <!-- Search -->
                    <VBox spacing="8">
                        <Label text="Search Keyword" styleClass="filter-label"/>
                        <TextField fx:id="searchField" promptText="Location, name..." styleClass="text-field"/>
                    </VBox>

                    <!-- Price Filters -->
                    <VBox spacing="8">
                        <Label text="Price Range" styleClass="filter-label"/>
                        <RadioButton fx:id="priceAny" text="Any Price" toggleGroup="${priceGroup}" selected="true"/>
                        <RadioButton fx:id="price1" text="৳0 - ৳10,000" toggleGroup="${priceGroup}"/>
                        <RadioButton fx:id="price2" text="৳10,000 - ৳20,000" toggleGroup="${priceGroup}"/>
                        <RadioButton fx:id="price3" text="৳20,000 - ৳30,000" toggleGroup="${priceGroup}"/>
                        <RadioButton fx:id="price4" text="৳30,000+" toggleGroup="${priceGroup}"/>
                    </VBox>

                    <!-- Property Type -->
                    <VBox spacing="8">
                        <Label text="Property Type" styleClass="filter-label"/>
                        <CheckBox fx:id="typeRoom" text="Room"/>
                        <CheckBox fx:id="typeFlat" text="Flat"/>
                        <CheckBox fx:id="typeApartment" text="Apartment"/>
                        <CheckBox fx:id="typeOffice" text="Office Area"/>
                        <CheckBox fx:id="typeParking" text="Parking"/>
                    </VBox>

                    <!-- Bedrooms -->
                    <VBox spacing="8">
                        <Label text="Bedrooms" styleClass="filter-label"/>
                        <RadioButton fx:id="bedAny" text="Any" toggleGroup="${bedGroup}" selected="true"/>
                        <RadioButton fx:id="bed1" text="1" toggleGroup="${bedGroup}"/>
                        <RadioButton fx:id="bed2" text="2" toggleGroup="${bedGroup}"/>
                        <RadioButton fx:id="bed3" text="3+" toggleGroup="${bedGroup}"/>
                    </VBox>

                    <!-- Amenities -->
                    <VBox spacing="8">
                        <Label text="Amenities" styleClass="filter-label"/>
                        <CheckBox fx:id="amenWifi" text="Wi-Fi"/>
                        <CheckBox fx:id="amenParking" text="Parking"/>
                        <CheckBox fx:id="amenPets" text="Pets Allowed"/>
                        <CheckBox fx:id="amenLift" text="Lift"/>
                        <CheckBox fx:id="amenSecurity" text="Security"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" minHeight="20"/>

                    <!-- Buttons -->
                    <Button text="Apply Filters" styleClass="button-primary" maxWidth="Infinity" onAction="#handleApplyFilters"/>
                    <Button text="Reset Filters" styleClass="button-secondary" maxWidth="Infinity" onAction="#handleResetFilters"/>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- 🔹 Content Area -->
    <center>
        <StackPane styleClass="content-area">
            
            <VBox fx:id="loadingState" alignment="CENTER" spacing="10" visible="false" managed="false">
                <ProgressIndicator />
                <Label text="Loading properties..." styleClass="text-secondary"/>
            </VBox>
            
            <VBox fx:id="emptyState" alignment="CENTER" spacing="16" visible="false" managed="false">
                <Label text="No properties found" styleClass="text-h2"/>
                <Label text="Try adjusting your filters or search terms." styleClass="text-secondary"/>
                <Button text="Reset Filters" onAction="#handleResetFilters" styleClass="button-secondary"/>
            </VBox>
            
            <VBox fx:id="errorState" alignment="CENTER" spacing="16" visible="false" managed="false">
                <Label text="Error Loading Properties" styleClass="text-h2"/>
                <Label text="Unable to load the property list." styleClass="text-secondary"/>
                <Button text="Retry" onAction="#handleApplyFilters" styleClass="button-primary"/>
            </VBox>

            <ScrollPane fx:id="contentScroll" fitToWidth="true" styleClass="edge-to-edge">
                <VBox spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Properties for Rent" styleClass="text-h1"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="resultCountLabel" text="0 results" styleClass="text-secondary"/>
                    </HBox>
                    <TilePane fx:id="grid" hgap="24" vgap="24" prefColumns="3" styleClass="card-grid" />
                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

</BorderPane>
