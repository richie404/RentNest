<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="RenterDashboardController"
            stylesheets="@RenterDashboard.css">

    <!-- 🔹 Shared Top Bar -->
    <top>
        <fx:include source="TopBar.fxml" fx:id="topBar"/>
    </top>

    <!-- 🔹 Dashboard Tabs -->
    <center>
        <TabPane minWidth="0" minHeight="0">
            <tabs>

                <!-- 🏡 Dashboard Tab -->
                <Tab text="Dashboard" closable="false">
                    <BorderPane>

                        <!-- 🔹 Header -->
                        <top>
                            <HBox spacing="20" styleClass="header">
                                <padding>
                                    <Insets top="20" right="20" bottom="20" left="20"/>
                                </padding>


                                <Label text="🏡 Renter Dashboard" styleClass="label-title"/>
                                <Pane HBox.hgrow="ALWAYS"/>

                                <Button text="Browse Properties"
                                        onAction="#handleBrowse"
                                        styleClass="button-secondary"/>
                            </HBox>
                        </top>

                        <!-- 🔹 Favorites Section -->
                        <center>
                            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20;">
                                <Label text="Favorite Properties"
                                       styleClass="page-title"/>

                                <ListView fx:id="favoritesList"
                                          styleClass="list-view" minWidth="0" minHeight="100" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </center>
                    </BorderPane>
                </Tab>

                <!-- 💬 Messages Tab -->
                <Tab text="Messages" closable="false">
                    <VBox spacing="12" alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <Label text="Your Chat History"
                               styleClass="page-title"/>

                        <ListView fx:id="messageList"
                                  styleClass="list-view" minWidth="0" minHeight="100" VBox.vgrow="ALWAYS"/>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button text="💬 View Chat"
                                    onAction="#handleViewChat"
                                    styleClass="button-primary"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- 📅 My Bookings Tab -->
                <!-- 📅 My Bookings Tab -->
                <Tab text="My Bookings" closable="false">
                    <fx:include source="RenterBookings.fxml" fx:id="RenterBookingsController"/>
                </Tab>


            </tabs>
        </TabPane>
    </center>
</BorderPane>
