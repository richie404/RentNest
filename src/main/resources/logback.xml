<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ══════════════════════════════════════════════════
         CONSOLE — INFO and above for day-to-day operation
         ══════════════════════════════════════════════════ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════
         ROLLING FILE — DEBUG and above; keeps 30 days
         ══════════════════════════════════════════════════ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/rentnest.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/rentnest.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{50} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════════════
         Silence noisy third-party frameworks
         ══════════════════════════════════════════════════ -->
    <logger name="com.zaxxer.hikari"     level="WARN"/>
    <logger name="com.mysql"             level="WARN"/>
    <logger name="javafx"                level="WARN"/>

    <!-- ══════════════════════════════════════════════════
         Root — DEBUG to file, INFO to console
         ══════════════════════════════════════════════════ -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
